<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8" pattern="[%-5p] %d %c - %m%n" />
        </Console>

        <RollingFile name="RollingFile" fileName="/root/data/corgi-worker/logs/corgi-worker.log"
                     filePattern="/root/data/corgi-worker/logs/corgi-worker-%d{yyyy-MM-dd}.log"
                     filePermissions="rw-r--r--">
            <PatternLayout alwaysWriteExceptions="false" pattern="%d{yyyy.MM.dd 'at' HH:mm:ss z} %-5level %class{36} %L %M requestId: %X{reqId} - userID : %X{usrID} %msg%dT%xEx%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" />
                <SizeBasedTriggerPolicy size = "100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10">
                <Delete basePath="/root/data/corgi-worker/logs/" maxDepth="2">
                    <IfFileName glob="*.log" />
                    <IfLastModified age="2d" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.corgi" level="debug" additivity="false">
            <!--<AppenderRef ref="Console"/> -->
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Root level="info">
            <!--<AppenderRef ref="Console" />-->
            <AppenderRef ref="RollingFile" />
        </Root>
    </Loggers>
</configuration>